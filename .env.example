MYSQL_ROOT_PASSWORD=rootpass
DB_NAME=difol
DB_USER=difol
DB_PASSWORD=difol

# Zona horaria de los contenedores de mysql y backend (fecha/hora de El Salvador,
# sin horario de verano). Afecta NOW()/CURRENT_TIMESTAMP en la base de datos y
# los calculos de "hoy"/"mes actual" en el backend.
TZ=America/El_Salvador
# Secreto para firmar los JWT de sesion. Generar uno propio en produccion,
# por ejemplo con: openssl rand -hex 32
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Solo para docker-compose.prod.yml: token del conector del tunnel de Cloudflare
# (Zero Trust -> Networks -> Tunnels -> tu tunnel -> "Install and run a connector").
# No hace falta para desarrollo (docker-compose.yml no lo usa).
CLOUDFLARE_TUNNEL_TOKEN=
